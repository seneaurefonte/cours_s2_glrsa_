						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGcuBkx6+0wMN0=",
							"_parent": {
								"$ref": "AAAAAAGcr5pgg5Q1dkw="
							},
							"font": "Arial;13;0",
							"head": {
								"$ref": "AAAAAAGcuBkxye0b2nM="
							},
							"tail": {
								"$ref": "AAAAAAGcr8mKhKO7wKc="
							},
							"lineStyle": 1,
							"points": "1040:106;1071:106"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGcuBvBQQHjXCI=",
							"_parent": {
								"$ref": "AAAAAAGcr5pgg5Q1dkw="
							},
							"font": "Arial;16;0",
							"left": 696,
							"top": 496,
							"width": 825,
							"height": 590,
							"text": "1-Redefinition\n   a-Heriter une methode \n   b-changer le code de la methode\n\nNB : Lorsqu'une classe  Fille herite d'une methode abstraites\n a-Je ne redefinit pas la methodes abstraites ==>La Classe Fille devient abstraites\n b-Je redefinit la methodes abstraites  i.e donner un code a la methode abstract==> La Classe Fille reste concrete\n\n2-Polymorphisme\n  a-Objet (conversion entre des classes Filles et des classes Meres)\n      i-Convertion d'un Objet  Fille vers objet Mere.   Mere m =new Fille()\n          var f :Figure \n          //On convertir un carre en figure donc toutes les methodes heritees peuvent etre appelees a partir de l'objet f\n            f<--new Carre(10)\n            f.getCote()\n            f.perimetre()\n            f.surface()\n            f.diagonale() //Erreur car diagonale() est propre a carre\n         \n     i-Convertion d'un Objet  Mere vers objet Fille.  Fille fille=(Fille) m\n        f.diagonale() //Erreur car diagonale() est propre a carre\n        ((Carre)f).diagonale()\n  b-Converstion de Methodes\n            var f :Figure \n           f<--new Carre(10)\n           f.getCode(). //methodes n'est pas polymorphes car elle execute toujours le code\n           f.perimetre(). //execute le code du perimetre du carre\n\n           f<--new Triangle(10)\n           f.perimetre() //execute le code du perimetre du triangle\n          f.getCode()\n\n    NB : Toutes les methodes redefinies  sont polymorphes\n        "
						}
					]
				},
